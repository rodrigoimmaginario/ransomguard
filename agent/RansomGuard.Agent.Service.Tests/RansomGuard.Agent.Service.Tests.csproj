<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes do SERVIÇO do agente (a cola com o Windows). Fora da RansomGuard.sln, como o serviço.
    Duas famílias:
      - testes comuns: rodam em qualquer Windows, sem elevação;
      - [ElevatedFact]: precisam de administrador (ler o Security log, criar share, ligar auditoria).
        Pulam na máquina do desenvolvedor e rodam no runner windows-latest da CI, onde RG_REQUIRE_ELEVATED=1
        transforma "não estou elevado" em falha — um teste pulado em silêncio não prova nada.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel para o teste de TLS com certificado autoassinado (o painel real em miniatura). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RansomGuard.Agent.Service\RansomGuard.Agent.Service.csproj" />
  </ItemGroup>

</Project>

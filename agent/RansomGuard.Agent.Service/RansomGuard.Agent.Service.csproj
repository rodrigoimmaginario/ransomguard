<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- net10-windows e FORA da RansomGuard.sln: buildar à parte. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-RansomGuard.Agent.Service-b21ea77d-2dab-491a-b01e-33ba0489ceb9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- D5: WMI em processo (contagem de cópias de sombra) no lugar de um powershell.exe por ciclo. -->
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RansomGuard.Agent\RansomGuard.Agent.csproj" />
    <ProjectReference Include="..\..\core\RansomGuard.Core\RansomGuard.Core.csproj" />
  </ItemGroup>
</Project>

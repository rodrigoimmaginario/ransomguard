<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Gate de cobertura (F21). Escopo: só o assembly de produção RansomGuard.Agent (lib testável).
         Piso com folga sobre o medido em 2026-09-01 (linha 79,0%). O serviço Windows (net10-windows)
         fica fora da .sln e não entra na cobertura. Ativado quando CollectCoverage=true. -->
    <Include>[RansomGuard.Agent]*</Include>
    <Threshold>75,60</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- XML de eventos capturados num Windows real pela CI (M1a): o contrato entre o Windows e o parser. -->
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RansomGuard.Agent\RansomGuard.Agent.csproj" />
    <ProjectReference Include="..\..\core\RansomGuard.Core\RansomGuard.Core.csproj" />
  </ItemGroup>

</Project>

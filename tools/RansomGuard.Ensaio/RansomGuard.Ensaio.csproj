<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Provocador de ensaio para rodar NO CLIENTE (F19). FORA da RansomGuard.sln (molde do Service):
         buildar/publicar à parte. Self-contained win-x64 single-file: roda em cliente SEM .NET. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RansomGuard-Ensaio</AssemblyName>
    <RootNamespace>RansomGuard.Ensaio</RootNamespace>

    <!-- Publicação: um único .exe autossuficiente para a estação de teste. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Toda a lógica e as 5 travas vêm da lib testada. Este projeto é só a casca. -->
    <ProjectReference Include="..\..\agent\RansomGuard.Agent\RansomGuard.Agent.csproj" />
    <ProjectReference Include="..\..\core\RansomGuard.Core\RansomGuard.Core.csproj" />
  </ItemGroup>
</Project>

@* Campo de segredo: o valor salvo NUNCA volta para a tela. Se já existe um segredo, mostra um
   placeholder mascarado e só grava se o admin digitar algo novo. O painel do cliente não devolve
   credencial. *@
<label class="nf-row nf-field">
    <span>@label</span>
    <input type="password"
           value="@Value"
           placeholder="@(set ? "•••••••• (configurado — deixe em branco para manter)" : "")"
           @oninput="OnInput" />
</label>

@code {
    [Parameter] public string label { get; set; } = "";
    /// <summary>Já existe um segredo salvo? Muda só o placeholder — o valor real nunca é enviado.</summary>
    [Parameter] public bool set { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
